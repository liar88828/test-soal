// This is your Prisma teacherFormData file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator zod {
  provider = "zod-prisma-types"

  output                           = "../../shared/src/lib/validate" // default is ./generated/zod
  useMultipleFiles                 = true // default is false
  // writeBarrelFiles                 = false // default is true
  createInputTypes                 = false // default is true
  // createModelTypes                 = false // default is true
  addInputTypeValidation           = false // default is true
  addIncludeType                   = false // default is true
  addSelectType                    = false // default is true
  validateWhereUniqueInput         = false // default is true
  createOptionalDefaultValuesTypes = true // default is false
  createRelationValuesTypes        = true // default is false
  createPartialTypes               = true // default is false
  // useDefaultValidators             = false // default is true
  coerceDate                       = false // default is true
  writeNullishInModelTypes         = true // default is false
}

model Soal {
  id          Int        @id @default(autoincrement())
  nameSubject String
  author      String
  SoalABC     SoalABC[]
  SoalText    SoalText[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SoalABC {
  id       Int    @id @default(autoincrement())
  question String
  A        String
  B        String
  C        String
  D        String
  E        String
  answer   String

  Answer Answer[]
  idSoal Int
  Soal   Soal     @relation(fields: [idSoal], references: [id], onDelete: Cascade)
}

model SoalText {
  id       Int    @id @default(autoincrement())
  question String
  text     String
  answer   String

  Answer Answer[]
  soalId Int
  Soal   Soal     @relation(fields: [soalId], references: [id], onDelete: Cascade)
}

model StudentAnswer {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  answers   Answer[]
  createdAt DateTime @default(now())
}

model Grade {
  id                  String                @id @default(uuid())
  name                String
  level               Level
  grade               Int?
  Classes             Classes[]
  Mapel               Mapel[]
  OptionClassSchedule OptionClassSchedule[]
}

enum Gender {
  Male
  Female
}

model Teacher {
  id        String    @id @default(uuid())
  name      String
  subject   String
  phone     String    @unique
  email     String    @unique
  address   String
  photo     String
  gender    Gender
  birthDate DateTime
  createdAt DateTime  @default(now())
  Mapel     Mapel[]
  Classes   Classes[]
}

model Classes {
  id          String    @id @default(uuid())
  section     String
  room        String
  //
  idTeacher   String
  nameTeacher String
  Teacher     Teacher   @relation(fields: [idTeacher], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
  idGrade     String
  Grade       Grade     @relation(fields: [idGrade], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
  Student     Student[]
  // countStudents Int
}

model Mapel {
  id          String  @id @default(uuid())
  name        String
  jp          Int
  //
  idGrade     String
  Grade       Grade   @relation(fields: [idGrade], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
  idTeacher   String
  nameTeacher String
  Teacher     Teacher @relation(fields: [idTeacher], references: [id], onDelete: Cascade, onUpdate: Cascade)
  //
}

enum Level {
  PAUD
  TK
  SD
  SMP
  SMK
}

model OptionClassSchedule {
  id          String @id @default(uuid())
  idGrade     String
  Grade       Grade  @relation(fields: [idGrade], references: [id])
  nameSubject String
  jp          Int
}

model Answer {
  id        Int      @id @default(autoincrement())
  soalId    Int
  selected  String // A, B, C, D, E
  createdAt DateTime @default(now())

  studentId Int
  student   StudentAnswer @relation(fields: [studentId], references: [id], onDelete: Cascade)

  soalABCId  Int?
  SoalABC    SoalABC?  @relation(fields: [soalABCId], references: [id], onDelete: Cascade)
  soalTextId Int?
  SoalText   SoalText? @relation(fields: [soalTextId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("USER")
  password  String
  createdAt DateTime @default(now())
}

model Student {
  // Identitas dasar
  id           String   @id @default(uuid())
  nis          String   @unique
  namaLengkap  String
  jenisKelamin Gender
  tanggalLahir DateTime
  tempatLahir  String

  // Data akademik
  kelas       String
  jurusan     String
  tahunMasuk  Int
  tahunKeluar Int?

  // Data kontak
  alamat String
  noHp   String?
  email  String?

  // Data orang tua / wali
  namaAyah      String?
  pekerjaanAyah String?
  namaIbu       String?
  pekerjaanIbu  String?
  namaWali      String?
  pekerjaanWali String?
  noHpWali      String?

  // Metadata
  status    StatusSiswa
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Classes   Classes?    @relation(fields: [idClass], references: [id])
  idClass   String?
}

// Enum untuk status siswa
enum StatusSiswa {
  aktif
  lulus
  keluar
}

model FinanceSubject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  category    String
  cost        Int // stored as integer (rupiah)
  description String?
  semester    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relation
  costList CostItem[]
}

model CostItem {
  id          String         @id @default(uuid())
  subject     FinanceSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  name        String
  amount      Int // integer rupiah
  description String?
  createdAt   DateTime       @default(now())
}

model FinanceBillStudent {
  id        String     @id @default(uuid())
  name      String // nama siswa
  kelas     String // kelas siswa
  bulan     String // bulan tagihan
  nominal   Int // jumlah tagihan (rupiah)
  status    BillStatus @default(BELUM)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum BillStatus {
  LUNAS
  BELUM
}

model FinanceRoom {
  id        String   @id @default(uuid())
  room      String
  cost      Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeCashFlow {
  Masuk
  Keluar
}

model FinanceCashFlow {
  id          String   @id @default(uuid())
  type        String // "Masuk" or "Keluar"
  description String
  amount      Int
  date        DateTime
}
