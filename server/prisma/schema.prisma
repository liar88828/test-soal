// This is your Prisma teacherFormData file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
	provider = "prisma-client-js"
	output   = "../generated/prisma"
}

datasource db {
	provider = "sqlite"
	url      = env("DATABASE_URL")
}

generator zod {
	provider = "zod-prisma-types"

	output                           = "../../shared/src/lib/validate" // default is ./generated/zod
	useMultipleFiles                 = true // default is false
	// writeBarrelFiles                 = false // default is true
	createInputTypes                 = false // default is true
	// createModelTypes                 = false // default is true
	addInputTypeValidation           = false // default is true
	addIncludeType                   = false // default is true
	addSelectType                    = false // default is true
	validateWhereUniqueInput         = false // default is true
	createOptionalDefaultValuesTypes = true // default is false
	createRelationValuesTypes        = true // default is false
	createPartialTypes               = true // default is false
	// useDefaultValidators             = false // default is true
	coerceDate                       = false // default is true
	writeNullishInModelTypes         = true // default is false
}

model Soal {
	id          Int        @id @default(autoincrement())
	nameSubject String
	author      String
	SoalABC     SoalABC[]
	SoalText    SoalText[]
	createdAt   DateTime   @default(now())
	updatedAt   DateTime   @updatedAt
}

model SoalABC {
	id       Int    @id @default(autoincrement())
	question String
	A        String
	B        String
	C        String
	D        String
	E        String
	answer   String

	Answer Answer[]
	soalId Int
	Soal   Soal     @relation(fields: [soalId], references: [id], onDelete: Cascade)
}

model SoalText {
	id       Int    @id @default(autoincrement())
	question String
	text     String
	answer   String

	Answer Answer[]
	soalId Int
	Soal   Soal     @relation(fields: [soalId], references: [id], onDelete: Cascade)
}

model Student {
	id          Int      @id @default(autoincrement())
	nameSubject String
	email       String   @unique
	answers     Answer[]
	createdAt   DateTime @default(now())
}

enum TeacherGender {
	Male
	Female
}

model Teacher {
	id          String        @id @default(uuid())
	nameSubject String
	subject     String
	phone       String        @unique
	email       String        @unique
	address     String
	photo       String
	gender      TeacherGender
	birthDate   DateTime

	createdAt DateTime @default(now())
}

model Answer {
	id        Int      @id @default(autoincrement())
	soalId    Int
	selected  String // A, B, C, D, E
	createdAt DateTime @default(now())

	studentId Int
	student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

	soalABCId  Int?
	SoalABC    SoalABC?  @relation(fields: [soalABCId], references: [id], onDelete: Cascade)
	soalTextId Int?
	SoalText   SoalText? @relation(fields: [soalTextId], references: [id], onDelete: Cascade)
}

model User {
	id          String   @id @default(cuid())
	nameSubject String
	email       String   @unique
	role        String   @default("USER")
	password    String
	createdAt   DateTime @default(now())
}
